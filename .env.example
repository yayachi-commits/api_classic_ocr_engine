# Application Settings
APP_NAME=Classic OCR Engine
APP_ENV=dev
APP_VERSION=1.0.0
DEBUG=false
DOCS_ENABLED=true
LOG_LEVEL=INFO

# Server Settings
HOST=0.0.0.0
PORT=9003
API_PREFIX=/api/v1
REQUEST_TIMEOUT_SECONDS=300
GZIP_MIN_SIZE=1024

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# OCR Settings
MAX_FILE_SIZE_MB=100
SUPPORTED_FORMATS=pdf,docx,html,txt
ENABLE_OCR=true
